# M/S FOUR STAR CARGO — HOSTINGER APACHE CONFIGURATION (DIST)
Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API Backend Route Rewrites
  RewriteRule ^api/db/?$ api/db.php [L,QSA]
  RewriteRule ^api/db\.php$ api/db.php [L,QSA]

  # 2. SPA Fallback: Send all non-file requests directly to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ index.html [L]
</IfModule>
