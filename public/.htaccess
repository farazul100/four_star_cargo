# M/S FOUR STAR CARGO — HOSTINGER APACHE CONFIGURATION (DIST)
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API Route Rewrite for Hostinger Backend Persistence
  RewriteRule ^api/db/?$ api/db.php [L,QSA]
  RewriteRule ^api/db\.php$ api/db.php [L,QSA]

  # 2. SPA Route Rewrite - Send all non-file/non-directory requests to /index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>
