# M/S FOUR STAR CARGO — HOSTINGER APACHE & LITESPEED CONFIGURATION
DirectoryIndex index.php dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API Route Rewrite for Hostinger Database Persistence
  RewriteRule ^api/db/?$ api/db.php [L,QSA]
  RewriteRule ^api/db\.php$ api/db.php [L,QSA]

  # 2. Serve static dist assets & files (assets/, images, etc.) natively
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 3. Direct Root Request (/) to index.php
  RewriteRule ^$ index.php [L]

  # 4. SPA Sub-Route Rewrite: Send all non-file/non-directory requests to index.php
  # index.php cleanly serves compiled dist/index.html with zero rewrite loops
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule . index.php [L]
</IfModule>
