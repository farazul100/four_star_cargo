# M/S FOUR STAR CARGO — HOSTINGER APACHE & LITESPEED CONFIGURATION
Options -Indexes -MultiViews
DirectoryIndex index.html index.php dist/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API Backend Route Rewrites (MUST BE FIRST!)
  RewriteRule ^api/db/?$ api/db.php [L,QSA]
  RewriteRule ^api/db\.php$ api/db.php [L,QSA]

  # 2. Stop rules for API and Static Asset Requests
  RewriteRule ^api/ - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^dist/index\.html$ - [L]

  # 3. Serve physical files directly if they exist
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Serve compiled static dist assets natively
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 5. SPA Fallback: Send ALL non-file frontend sub-routes directly to index.php (Fixes 403 Forbidden)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ index.php [L]
</IfModule>
