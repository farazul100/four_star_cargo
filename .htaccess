# M/S FOUR STAR CARGO — HOSTINGER APACHE & LITESPEED CONFIGURATION
DirectoryIndex index.html index.php dist/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Immediate Stop Rules for Static Files & API (Prevents 408 Timeouts)
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^dist/index\.html$ - [L]
  RewriteRule ^api/ - [L]

  # 2. Hostinger DB Persistence API Routing
  RewriteRule ^api/db/?$ api/db.php [L,QSA]
  RewriteRule ^api/db\.php$ api/db.php [L,QSA]

  # 3. Serve physical static files directly if present
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Serve compiled assets from /dist/assets if requested at /assets
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 5. SPA Route Rewrite: Send all non-file/non-directory frontend sub-routes directly to /index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
