# M/S FOUR STAR CARGO — HOSTINGER APACHE & LITESPEED CONFIGURATION
DirectoryIndex dist/index.html index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. API Route Rewrite for Hostinger Database Persistence (MUST BE FIRST!)
  RewriteRule ^api/db/?$ api/db.php [L,QSA]
  RewriteRule ^api/db\.php$ api/db.php [L,QSA]

  # 2. Immediate Stop Rules for Static Files & API (Prevents Loops)
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^dist/index\.html$ - [L]
  RewriteRule ^api/ - [L]

  # 3. Serve static dist assets & files (assets/, images, etc.) natively
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 4. Direct Root Request (/) to dist/index.html
  RewriteRule ^$ dist/index.html [L]

  # 5. SPA Sub-Route Rewrite: Send all non-file/non-directory requests to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule . index.php [L]
</IfModule>
